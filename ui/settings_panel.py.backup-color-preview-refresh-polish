    def _normalize_hex_color_text(self, text: str) -> str | None:
        clean = str(text).strip().upper()

        if clean.startswith("#"):
            clean = clean[1:]

        if len(clean) == 3:
            clean = "".join(ch * 2 for ch in clean)

        if len(clean) != 6:
            return None

        valid_chars = "0123456789ABCDEF"
        if any(ch not in valid_chars for ch in clean):
            return None

        return f"#{clean}"

    def _rgb_from_hex_text(self, text: str) -> tuple[int, int, int] | None:
        normalized = self._normalize_hex_color_text(text)
        if normalized is None:
            return None

        clean = normalized.lstrip("#")
        return (
            int(clean[0:2], 16),
            int(clean[2:4], 16),
            int(clean[4:6], 16),
        )

    def _hex_from_rgb(self, rgb: tuple[int, int, int]) -> str:
        r, g, b = rgb
        return f"#{max(0, min(255, int(r))):02X}{max(0, min(255, int(g))):02X}{max(0, min(255, int(b))):02X}"

    def _cmyk_from_rgb(self, rgb: tuple[int, int, int]) -> tuple[int, int, int, int]:
        red, green, blue = [max(0, min(255, int(value))) for value in rgb]
        if red == 0 and green == 0 and blue == 0:
            return 0, 0, 0, 100

        r = red / 255.0
        g = green / 255.0
        b = blue / 255.0
        k = 1.0 - max(r, g, b)

        if k >= 1.0:
            return 0, 0, 0, 100

        c = (1.0 - r - k) / (1.0 - k)
        m = (1.0 - g - k) / (1.0 - k)
        y = (1.0 - b - k) / (1.0 - k)

        return (
            int(round(c * 100)),
            int(round(m * 100)),
            int(round(y * 100)),
            int(round(k * 100)),
        )

    def _rgb_from_cmyk(self, c: int, m: int, y: int, k: int) -> tuple[int, int, int]:
        c = max(0.0, min(1.0, float(c) / 100.0))
        m = max(0.0, min(1.0, float(m) / 100.0))
        y = max(0.0, min(1.0, float(y) / 100.0))
        k = max(0.0, min(1.0, float(k) / 100.0))

        red = int(round(255.0 * (1.0 - c) * (1.0 - k)))
        green = int(round(255.0 * (1.0 - m) * (1.0 - k)))
        blue = int(round(255.0 * (1.0 - y) * (1.0 - k)))

        return red, green, blue

